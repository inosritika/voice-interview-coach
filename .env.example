# Copy to .env and edit. Defaults are all-local — no keys needed to run.

# --- Pipeline (how a whole turn is processed) --------------------------------
PIPELINE=cascaded         # cascaded (whisper STT + Ollama LLM) | fused (Gemma 4 does both)

# --- Engine selection (used by the cascaded pipeline) ------------------------
STT_ENGINE=local          # local (faster-whisper) | deepgram
TTS_ENGINE=local          # local (piper)          | cartesia
LLM_ENGINE=local          # local (ollama)         | openai

# --- Fused pipeline: Gemma 4 (only when PIPELINE=fused) ----------------------
# Requires: pip install "transformers>=4.55" accelerate. NOT gated (Apache-2.0,
# no license click needed) — just a multi-GB download on first run.
GEMMA_MODEL=google/gemma-4-E4B-it   # audio sizes: E2B (fastest) | E4B (balanced) | 12B (best/slowest)
GEMMA_DEVICE=auto                   # auto | cpu | mps (Apple GPU) | cuda
GEMMA_MAX_NEW_TOKENS=160

# --- Local STT: faster-whisper ----------------------------------------------
# "base" with greedy decode (WHISPER_BEAM_SIZE=1) + a pinned language is ~0.5s
# per utterance on CPU and accurate on clean speech — the right default for a
# real-time voice loop. Bump to "small" (~1.6s) only if your mic/accent mishears.
WHISPER_MODEL=base        # tiny | base | small | medium | large-v3
WHISPER_BEAM_SIZE=1       # 1 = greedy (fast); 5 = the slow library default
WHISPER_LANGUAGE=en       # pinned so whisper skips a detect-language pass ("" = auto)
WHISPER_DEVICE=cpu        # cpu | cuda
WHISPER_COMPUTE_TYPE=int8

# --- Local TTS: piper --------------------------------------------------------
# Download a voice (.onnx + .onnx.json) and point here.
# https://github.com/rhasspy/piper/blob/master/VOICES.md
PIPER_VOICE=voices/en_US-lessac-medium.onnx

# --- Step 2: VAD + endpointing ----------------------------------------------
VAD_THRESHOLD=0.5           # speech if Silero prob >= this (higher = stricter)
ENDPOINT_SILENCE_MS=700     # pause length that means "you're done" (the patience knob)
MIN_SPEECH_MS=250           # ignore blips shorter than this (coughs, clicks)
SPEECH_PREROLL_MS=160       # audio kept from just before VAD triggered

# --- Semantic turn detection (two-stage endpointing) --------------------------
# semantic: at MIN silence the smart-turn model judges whether you SOUND done —
# finished ends the turn early (snappy), unfinished extends patience to MAX (no
# more mid-thought guillotines). Needs the ~8MB model in backend/models/ (see
# backend/turndetect/smart_turn.py for the one-line download).
ENDPOINT_MODE=silence       # silence | semantic
ENDPOINT_MIN_SILENCE_MS=450
ENDPOINT_MAX_SILENCE_MS=1400
SEMANTIC_TURN_THRESHOLD=0.5

# --- Step 4: barge-in (interrupting the interviewer mid-sentence) -------------
# A run of BARGEIN_MIN_SPEECH_MS of speech above BARGEIN_THRESHOLD interrupts.
# The run tolerates up to BARGEIN_GAP_MS of quiet *inside* it — real speech dips
# between syllables, and without that tolerance you must shout continuously.
# Interrupting feels sluggish? Lower BARGEIN_THRESHOLD or BARGEIN_MIN_SPEECH_MS.
# The AI interrupts itself (on speakers, not headphones)? Raise the threshold.
BARGEIN_THRESHOLD=0.55
BARGEIN_MIN_SPEECH_MS=240
BARGEIN_GAP_MS=200

# --- Spoken-output guard (speech_filter.py) ----------------------------------
# on: the harness ends each turn at the first "?", so the persona's "exactly ONE
# question per turn" rule is guaranteed rather than merely requested. Bracketed
# stage directions ("[Wait for response]") are always stripped, either way.
ONE_QUESTION_PER_TURN=on

# --- Context compaction --------------------------------------------------------
# Keeps long interviews inside the LLM's context window: system prompt pinned,
# oldest exchanges rolled into an incremental summary. Full history untouched.
COMPACTION=on
COMPACTION_BUDGET_CHARS=24000
COMPACTION_KEEP_RECENT=8

# --- The interview director: agentic tool-use loop ---------------------------
# on: each turn = a "decide" loop (the model picks structured actions — note
# evidence, probe deeper, switch topic, end — as schema-constrained JSON) and
# then the streamed spoken reply guided by the chosen move. Costs ~2 extra
# small LLM calls per turn (~3-4s on llama3:8b). off: original single-call chat.
DIRECTOR=on
DIRECTOR_MAX_STEPS=4        # cap on decide-loop iterations per turn
DIRECTOR_NUM_PREDICT=120    # output cap per decide call (actions are short JSON)

# --- Local LLM: Ollama -------------------------------------------------------
# qwen2.5:7b follows instructions and reasons markedly better than llama3:8b at
# the same size (moves on when told, no "Here's a revised version:" narration,
# reliable JSON for the director/debrief, 32k context). `ollama pull qwen2.5:7b`.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_PREDICT=80     # hard cap on reply length (tokens) — keeps turns short & fast
OLLAMA_TEMPERATURE=0.7    # lower = less rambly / more on-task

# --- Hosted engines (only if you flip a flag above) --------------------------
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
